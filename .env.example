# Local, synthetic demo. Never commit real credentials or employee data.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/reis400.sqlite
# Empty disables the read-only HR/LMS integration. Generate at least 32 random characters.
HR_API_KEY=
# For HTTPS behind a reverse proxy set both of the following, and NODE_ENV=production.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
