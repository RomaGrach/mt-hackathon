{
  "name": "reis400-training-game",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "test:e2e": "playwright test",
    "validate:scenarios": "node scripts/validate-scenarios.mjs",
    "format:check": "prettier --check backend src scripts tests server.mjs playwright.config.js",
    "validate:shift": "node scripts/shift-content.mjs validate"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
